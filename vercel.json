{
  "version": 2,
  "redirects": [
    {
      "source": "/about.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/testimonials.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mitzvahs.html",
      "destination": "/events.html",
      "permanent": true
    },
    {
      "source": "/weddings.html",
      "destination": "/events.html",
      "permanent": true
    },
    {
      "source": "/special-events.html",
      "destination": "/events.html",
      "permanent": true
    },
    {
      "source": "/game-shows.html",
      "destination": "/events.html",
      "permanent": true
    },
    {
      "source": "/videography.html",
      "destination": "/services.html",
      "permanent": true
    },
    {
      "source": "/about-us/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/bar-bat-mitzvahs/",
      "destination": "/events.html",
      "permanent": true
    },
    {
      "source": "/weddings/",
      "destination": "/events.html",
      "permanent": true
    },
    {
      "source": "/special-events/",
      "destination": "/events.html",
      "permanent": true
    },
    {
      "source": "/game-shows/",
      "destination": "/events.html",
      "permanent": true
    },
    {
      "source": "/videography/",
      "destination": "/services.html",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/contact.html",
      "permanent": true
    },
    {
      "source": "/events/",
      "destination": "/events.html",
      "permanent": true
    },
    {
      "source": "/entertainment/",
      "destination": "/services.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|gif|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
